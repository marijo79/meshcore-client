# Serial port the companion radio is connected to
MESHCORE_PORT=/dev/ttyACM0

# Baud rate (must match firmware, usually 115200)
MESHCORE_BAUDRATE=115200

# Channel name to create / use for send and recv.
# Names starting with '#' derive their encryption key automatically from the name.
MESHCORE_CHANNEL=#mv

# Encryption key for the channel as a 32-character hex string (16 bytes).
# Required when the channel name does NOT start with '#' (e.g. "Public").
# Leave commented out for '#'-prefixed channels — the key is derived from the name.
# Example: MeshCore default "Public" channel
# MESHCORE_CHANNEL=Public
# MESHCORE_CHANNEL_KEY=000000000000000000000000000000000

# Path to the message log (JSONL). Relative paths are resolved from the project root.
# MESHCORE_LOG_FILE=messages.jsonl

# Seconds to wait after the ESP32-S3 USB-triggered reset before sending commands.
# Increase if you get "Device did not respond to appstart" on slow hardware.
# MESHCORE_CONNECT_WAIT=2.5